//  Secrets.xcconfig.example
//  iOS Example
//
//  Copy this file to Secrets.xcconfig (gitignored) and fill in your own
//  Yahoo Developer Network credentials from https://developer.yahoo.com/apps/
//  before building the iOS Example app.
//

YAHOO_CLIENT_ID = your_client_id_here
YAHOO_CLIENT_SECRET = your_client_secret_here
YAHOO_REDIRECT_URL = cdyahookitexample://callback
