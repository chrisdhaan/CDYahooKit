{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"CDYahooKit"}],"role":"article","title":"Getting Started","roleHeading":"Article"},"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/CDYahooKit\/documentation\/CDYahooKit"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Registering Your App","type":"heading","anchor":"Registering-Your-App"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an app at "},{"code":"developer.yahoo.com\/apps\/","type":"codeVoice"},{"type":"text","text":", request Fantasy Sports read access, and note"},{"type":"text","text":" "},{"type":"text","text":"your Client ID, Client Secret, and redirect URI (a custom URL scheme, e.g. "},{"code":"myapp:\/\/callback","type":"codeVoice"},{"type":"text","text":")."}]},{"level":2,"text":"Authenticating","type":"heading","anchor":"Authenticating"},{"code":["import CDYahooKit","","let client = CDYahooFantasyAPIClient(clientId: \"...\", clientSecret: \"...\", redirectUrl: \"myapp:\/\/callback\")","","let verifier = CDYahooPKCE.makeCodeVerifier()","let challenge = CDYahooPKCE.codeChallenge(for: verifier)","let state = UUID().uuidString","let authURL = try client.oAuthClient.authorizationURL(codeChallenge: challenge, state: state)","","let callback = try await CDYahooAuthSession(presentationAnchor: view.window!)","    .authorize(authorizationURL: authURL, callbackScheme: \"myapp\")","let code = try CDYahooAuthSession.extractCode(from: callback, expectedState: state)","try await client.oAuthClient.authorize(withCode: code, codeVerifier: verifier)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Fetching Data","type":"heading","anchor":"Fetching-Data"},{"code":["let games = try await client.fetchUserGames()","let leagueKey = games.games.first?.leagues.first?.leagueKey","","if let leagueKey {","    let standings = try await client.fetchLeagueStandings(leagueKey: leagueKey)","    for team in standings.teams {","        print(team.name, team.rank ?? 0)","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cdyahookit\/gettingstarted"]}],"identifier":{"url":"doc:\/\/CDYahooKit\/documentation\/CDYahooKit\/GettingStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Register an app at the "},{"type":"reference","identifier":"https:\/\/developer.yahoo.com\/apps\/","isActive":true},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"text","text":"authenticate and fetch data."}],"references":{"doc://CDYahooKit/documentation/CDYahooKit":{"title":"CDYahooKit","role":"collection","kind":"symbol","abstract":[{"text":"A Swift wrapper for the Yahoo Fantasy Sports API, with Sign In With Yahoo (OAuth 2.0 \/ PKCE)","type":"text"},{"type":"text","text":" "},{"text":"for authentication.","type":"text"}],"type":"topic","identifier":"doc:\/\/CDYahooKit\/documentation\/CDYahooKit","url":"\/documentation\/cdyahookit"}}}